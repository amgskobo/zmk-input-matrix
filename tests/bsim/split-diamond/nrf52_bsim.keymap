 *
 * A pad on the peripheral drives a 1x4 tap diamond on the central across the
 * split link: Up, Right, Down, Left at key positions 8 to 11.
 *
 * 4.0 s  A tap at the top: UP pressed and released at the lift.
 * 4.5 s  A tap at the right: RIGHT.
 * 5.0 s  A long press at the bottom: DOWN goes down 200 ms in and up at the
 *        lift at 5.4 s.
 * 6.0 s  A long press at the left: LEFT goes down at 6.2 s. Layer 1 goes up
 *        at 6.3 s, while the finger is still down, though layer 1 routes the
 *        pad through the same diamond.
 * 7.0 s  A tap at the top: UP.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

#include "shared.dtsi"

&kscan {
    /delete-property/ exit-after;
    /* A mock event's delay is also the wait after it, so a no-op release
     * leads: layer 1 goes up at 6.3 s and down at 6.6 s. */
    events = <ZMK_MOCK_RELEASE(1,1,3150) ZMK_MOCK_PRESS(0,0,300) ZMK_MOCK_RELEASE(0,0,300)>;
};

&split_listener {
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = &composite;
    };

    /* The mock's 2x2 on row 0 and 1, the diamond's four cells on row 2. */
    composite: composite {
        compatible = "zmk,kscan-composite";
        rows = <3>;
        columns = <4>;

        mock {
            kscan = <&kscan>;
        };

        gesture {
            kscan = <&kscan_gesture>;
            row-offset = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &mo 1  &kp B     &none    &none
            &kp C  &kp D     &none    &none
            &kp UP &kp RIGHT &kp DOWN &kp LEFT>;
        };

        layer_one {
            bindings = <
            &trans &trans &trans &trans
            &trans &trans &trans &trans
            &trans &trans &trans &trans>;
        };
    };
};
